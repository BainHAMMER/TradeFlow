package-as: TradeFlow
enable-nolib-creation: no

optional-dependencies:
  - auctionator
  - tradeskillmaster
  - syndicator
  - tomtom
  - questie
  - atlaslootclassic
  - disenchantbuddy

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - .gitignore
  - .pkgmeta
  - CHANGELOG_TECH.md
  - PLAN.md
  - README.md
  - Media/Logo.png
  - graphify-out

